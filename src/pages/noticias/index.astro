---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getNoticias } from '../../lib/data';
const noticias = await getNoticias();
---
<Base title="Noticias" description="Noticias, ferias, eventos y oportunidades de la federación y sus asociaciones.">
  <PageHead title="Noticias" lead="Ferias, eventos, oportunidades y novedades de las asociaciones." />
  <section class="block">
    <div class="wrap">
      <h2 class="sr-only">Noticias y eventos</h2>
      <ul class="grid-cards">
        {noticias.map((n) => <NewsCard noticia={n} />)}
      </ul>
    </div>
  </section>
</Base>
