---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { render } from 'astro:content';
import { getNoticias, tiposNoticia, fechaLarga } from '../../lib/data';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const noticias = await getNoticias();
  return noticias.map((noticia) => ({ params: { slug: noticia.id }, props: { noticia } }));
}
const { noticia } = Astro.props;
const d = noticia.data;
const { Content } = await render(noticia);
---
<Base title={d.titulo} description={d.resumen} image={d.foto} ogType="article">
  <PageHead title={d.titulo} lead={d.resumen} crumbs={[['Inicio', url('/')], ['Noticias', url('/noticias/')]]} />
  <article class="narrow" style="padding-block:2rem 3rem">
    <p><span class={`badge ${d.tipo}`}>{tiposNoticia[d.tipo]}</span> <time datetime={d.fecha.toISOString().slice(0, 10)}>{fechaLarga(d.fecha)}</time></p>
    {d.foto && <img class="photo" style="border-radius:12px;margin-bottom:1.5rem" src={url(d.foto)} alt="" width="800" height="600" />}
    <div class="prose"><Content /></div>
    <p><a href={url('/noticias/')}>← Todas las noticias</a></p>
  </article>
</Base>
