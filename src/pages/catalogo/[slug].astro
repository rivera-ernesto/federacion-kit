---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import WaButton from '../../components/WaButton.astro';
import { render } from 'astro:content';
import { getProductos, getOrgs, categorias, disponibilidades } from '../../lib/data';
import { url, absoluteUrl } from '../../lib/url';
import { msgProducto } from '../../lib/whatsapp';
import { siteConfig } from '../../site.config';

export async function getStaticPaths() {
  const [productos, orgs] = await Promise.all([getProductos(), getOrgs()]);
  return productos.map((producto) => ({
    params: { slug: producto.id },
    props: { producto, org: orgs.find((o) => o.id === producto.data.organizacion)! },
  }));
}
const { producto, org } = Astro.props;
const d = producto.data;
const { Content } = await render(producto);
const foto = d.foto ?? '/media/hero.svg';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.nombre,
  description: `${d.nombre} de ${org.data.nombre}. ${categorias[d.categoria]}.`,
  image: absoluteUrl(foto),
  category: categorias[d.categoria],
  brand: { '@type': 'Brand', name: org.data.nombre },
  manufacturer: { '@type': 'Organization', name: org.data.nombre, url: absoluteUrl(`/directorio/${org.id}/`) },
  url: absoluteUrl(`/catalogo/${producto.id}/`),
};
---
<Base title={d.nombre} description={`${d.nombre} de ${org.data.nombre} (${org.data.municipio}). Consulta disponibilidad por WhatsApp.`} image={foto} ogType="website" jsonLd={jsonLd}>
  <PageHead title={d.nombre} crumbs={[['Inicio', url('/')], ['Catálogo', url('/catalogo/')]]} />
  <div class="wrap detail">
    <div>
      <img class="photo" src={url(foto)} alt={d.nombre} width="800" height="600" fetchpriority="high" />
      <div class="prose" style="margin-top:1.5rem">
        <h2>Características</h2>
        <Content />
      </div>
    </div>
    <aside>
      <span class={`badge ${d.disponibilidad}`}>{disponibilidades[d.disponibilidad]}</span>
      <dl class="facts" style="margin-top:.8rem">
        <div><dt>Categoría</dt><dd>{categorias[d.categoria]}</dd></div>
        <div><dt>Productor</dt><dd><a href={url(`/directorio/${org.id}/`)}>{org.data.nombre}</a></dd></div>
        {d.temporada && <div><dt>Temporada</dt><dd>{d.temporada}</dd></div>}
      </dl>
      {d.presentaciones.length > 0 && (
        <>
          <h3>Presentaciones</h3>
          <ul class="tags">{d.presentaciones.map((p) => <li>{p}</li>)}</ul>
        </>
      )}
      <div class="actions">
        <WaButton text={msgProducto(d.nombre, org.data.nombre)} number={org.data.contacto.whatsapp} label="Consultar por WhatsApp" />
      </div>
      <div class="quick" id="agregar-bloque" hidden>
        <div class="qty" role="group" aria-label={`Cantidad de ${d.nombre}`}>
          <button type="button" id="q-menos" aria-label={`Menos ${d.nombre}`}>−</button>
          <input type="number" inputmode="numeric" min="1" max="9999" step="1" value="1" id="q-cant" aria-label={`Cantidad de ${d.nombre}`} />
          <button type="button" id="q-mas" aria-label={`Más ${d.nombre}`}>+</button>
        </div>
        <select class="pres" id="q-pres" aria-label={`Presentación de ${d.nombre}`}>
          {d.presentaciones.length ? d.presentaciones.map((p) => <option value={p}>{p}</option>) : <option value="">unidad</option>}
        </select>
        <button
          type="button"
          class="btn ghost"
          id="agregar"
          data-slug={producto.id}
          data-nombre={d.nombre}
          data-href={url(`/catalogo/${producto.id}/`)}
          data-org-id={org.id}
          data-org-nombre={org.data.nombre}
          data-org-wa={org.data.contacto.whatsapp}
          data-presentaciones={JSON.stringify(d.presentaciones)}
        >Agregar a mi lista de consulta</button>
      </div>
      <p class="sr-only" role="status" aria-live="polite" id="agregar-live"></p>
      <p class="note">La lista de consulta no es una tienda: no hay precios ni pagos. Sirve para enviar un solo mensaje por asociación. <a href={url('/mi-lista/')}>Ver mi lista</a>.</p>
      <p class="note">Contacto de la asociación: +{org.data.contacto.whatsapp}. Si prefieres hablar con la federación, escribe a +{siteConfig.whatsapp}.</p>
    </aside>
  </div>
  <script>
    import { agregarOActualizar, clamp, textoNota, UNIDAD } from '../../scripts/lista';
    const btn = document.getElementById('agregar') as HTMLButtonElement;
    const cant = document.getElementById('q-cant') as HTMLInputElement;
    const pres = document.getElementById('q-pres') as HTMLSelectElement;
    const live = document.getElementById('agregar-live')!;
    const step = (d: number) => { cant.value = String(clamp((parseInt(cant.value, 10) || 1) + d)); };
    document.getElementById('q-menos')!.addEventListener('click', () => step(-1));
    document.getElementById('q-mas')!.addEventListener('click', () => step(1));
    cant.addEventListener('change', () => { cant.value = String(clamp(parseInt(cant.value, 10))); });
    let timer = 0;
    btn.addEventListener('click', () => {
      const d = btn.dataset;
      const cantidad = clamp(parseInt(cant.value, 10));
      cant.value = String(cantidad);
      const presentacion = pres.value || undefined;
      const item = { slug: d.slug!, nombre: d.nombre!, href: d.href!, orgId: d.orgId!, orgNombre: d.orgNombre!, orgWa: d.orgWa!, nota: '', cantidad, presentacion, presentaciones: JSON.parse(d.presentaciones || '[]') as string[] };
      item.nota = textoNota(item);
      agregarOActualizar(item);
      btn.textContent = 'Agregado ✓';
      live.textContent = `${d.nombre}: ${cantidad} × ${presentacion ?? UNIDAD} en tu lista de consulta.`;
      clearTimeout(timer);
      timer = window.setTimeout(() => { btn.textContent = 'Agregar a mi lista de consulta'; }, 2000);
    });
    document.getElementById('agregar-bloque')!.hidden = false;
  </script>
</Base>
