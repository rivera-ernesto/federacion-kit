---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getOrgs, getProductos, categorias, disponibilidades } from '../../lib/data';
const [orgs, productos] = await Promise.all([getOrgs(), getProductos()]);
const orgById = new Map(orgs.map((o) => [o.id, o]));
---
<Base title="Catálogo de productos" description="Pulpas de fruta, cacao silvestre, harinas, castaña y más, producidos por las asociaciones de la federación.">
  <PageHead title="Catálogo de productos" lead="Filtra por categoría o disponibilidad y consulta directamente a la asociación productora." />
  <section class="block">
    <div class="wrap">
      <form class="filters js-only" data-filters aria-label="Filtros del catálogo">
        <div class="field">
          <label for="f-cat">Categoría</label>
          <select id="f-cat" data-filter="categoria">
            <option value="">Todas</option>
            {Object.entries(categorias).map(([k, v]) => <option value={k}>{v}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-disp">Disponibilidad</label>
          <select id="f-disp" data-filter="disponibilidad">
            <option value="">Todas</option>
            {Object.entries(disponibilidades).map(([k, v]) => <option value={k}>{v}</option>)}
          </select>
        </div>
      </form>
      <div class="results-bar">
        <p class="status" data-filter-status aria-live="polite"></p>
        <div class="view-toggle js-only" data-view-toggle role="group" aria-label="Tipo de vista">
          <button type="button" data-view="iconos" aria-pressed="true">Íconos</button>
          <button type="button" data-view="lista" aria-pressed="false">Lista</button>
        </div>
      </div>
      <p class="sr-only" role="status" aria-live="polite" data-quick-live></p>
      <h2 class="sr-only">Productos</h2>
      <ul class="grid-cards" data-results data-view="iconos">
        {productos.map((p) => <ProductCard producto={p} org={orgById.get(p.data.organizacion)!} />)}
      </ul>
      <p class="empty" data-filter-empty hidden>No hay productos con esos filtros. Prueba con otra combinación.</p>
    </div>
  </section>
  <script>import '../../scripts/filters';
    import '../../scripts/catalogo';
  </script>
</Base>
