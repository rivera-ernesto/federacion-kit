---
interface Props { title: string; lead?: string; crumbs?: [string, string][] }
const { title, lead, crumbs = [] } = Astro.props;
---
<div class="page-head">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Ruta">
        {crumbs.map(([label, href]) => <><a href={href}>{label}</a> / </>)}
        <span aria-current="page">{title}</span>
      </nav>
    )}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</div>
