---
// Mapa Leaflet + OpenStreetMap. Leaflet solo se carga en las páginas que usan este componente.
import { siteConfig } from '../site.config';
export interface Punto { nombre: string; lat: number; lon: number; href?: string; detalle?: string }
interface Props { puntos: Punto[]; zoom?: number; center?: [number, number]; size?: 'mini' | 'tall' | 'normal'; label: string }
const { puntos, zoom = siteConfig.map.zoom, center = siteConfig.map.center, size = 'normal', label } = Astro.props;
---
<div class={`map ${size === 'normal' ? '' : size}`} id={`map-${size}`} role="region" aria-label={label}
  data-puntos={JSON.stringify(puntos)} data-zoom={zoom} data-center={JSON.stringify(center)}>
  <p class="empty">El mapa necesita JavaScript. Mientras tanto, estas son las ubicaciones:</p>
</div>
<ul class="map-fallback">
  {puntos.map((p) => <li>{p.href ? <a href={p.href}>{p.nombre}</a> : p.nombre}{p.detalle ? ` · ${p.detalle}` : ''} ({p.lat.toFixed(2)}, {p.lon.toFixed(2)})</li>)}
</ul>
<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  const el = document.querySelector<HTMLElement>('.map[data-puntos]')!;
  const puntos: { nombre: string; lat: number; lon: number; href?: string; detalle?: string }[] = JSON.parse(el.dataset.puntos!);
  el.textContent = '';
  document.querySelector('.map-fallback')?.setAttribute('hidden', '');
  const map = L.map(el, { scrollWheelZoom: false }).setView(JSON.parse(el.dataset.center!), Number(el.dataset.zoom));
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 18,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">colaboradores de OpenStreetMap</a>',
  }).addTo(map);
  const icon = L.divIcon({ className: '', html: '<div class="pin"></div>', iconSize: [18, 18], iconAnchor: [9, 18], popupAnchor: [0, -16] });
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const bounds: [number, number][] = [];
  for (const p of puntos) {
    const html = `<strong>${p.href ? `<a href="${esc(p.href)}">${esc(p.nombre)}</a>` : esc(p.nombre)}</strong>${p.detalle ? `<br>${esc(p.detalle)}` : ''}`;
    L.marker([p.lat, p.lon], { icon, title: p.nombre, alt: p.nombre }).addTo(map).bindPopup(html);
    bounds.push([p.lat, p.lon]);
  }
  if (bounds.length > 1) map.fitBounds(bounds, { padding: [30, 30] });
</script>
